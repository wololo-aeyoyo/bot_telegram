# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321   # comma-separated whitelist
# In groups the bot only answers messages starting with one of these words
# (case-insensitive) or direct replies to the bot. Private chats always reply.
TELEGRAM_TRIGGER_PREFIXES=bot,hey bot,ok bot,yo bot,botto,bottino,oi,ao,robocla,robot,clanker

# LLM router — any OpenAI-compatible chat-completions endpoint
# NVIDIA NIM (free dev credits: https://build.nvidia.com):
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=deepseek-ai/deepseek-v4-flash
LLM_API_KEY=                                     # nvapi-... key from build.nvidia.com
# Local Ollama alternative:
#LLM_BASE_URL=http://localhost:11434/v1
#LLM_MODEL=llama3.1
#LLM_API_KEY=ollama

# yt-dlp backend
YTDLP_BASE_URL=http://ytdlp-backend.internal:8000
YTDLP_USERNAME=
YTDLP_PASSWORD=

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_DEFAULT_PLAYLIST_ID=

# Gelbooru (Images) — credentials required (anonymous API access gets 401)
# Get them at gelbooru.com -> My Account -> Options -> API Access Credentials
GELBOORU_API_KEY=
GELBOORU_USER_ID=
GELBOORU_RATING=general                          # general|sensitive|questionable|explicit|all

# Observability (Grafana stack) — all optional; each subsystem is off until set
OTEL_SERVICE_NAME=telegram-bot
OTEL_SERVICE_VERSION=0.1.0
LOG_LEVEL=info                                   # trace|debug|info|warn|error|fatal
#LOG_PRETTY=1                                     # human-readable logs for local dev (default: JSON for Loki)

# Tracing → Tempo (OTLP/HTTP protobuf; Tempo's default OTLP port is 4318).
# Setting this endpoint enables tracing. Point it at Tempo or an OTel Collector.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318

# Continuous profiling → Pyroscope. Setting the server address enables it.
#PYROSCOPE_SERVER_ADDRESS=http://pyroscope:4040
#PYROSCOPE_AUTH_TOKEN=                            # Grafana Cloud token, if applicable
#PYROSCOPE_BASIC_AUTH_USER=
#PYROSCOPE_BASIC_AUTH_PASSWORD=
