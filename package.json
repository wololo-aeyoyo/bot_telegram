{
  "name": "telegram-ollama-bot",
  "version": "0.1.0",
  "description": "Telegram multi-tool bot routed by a local Ollama model: yt-dlp downloads, Spotify playlists, Google Images, and chat fallback",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --import ./src/telemetry.js src/index.js",
    "spotify-auth": "node scripts/spotify-auth.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@pyroscope/nodejs": "^0.5.0",
    "dotenv": "^16.4.5",
    "pino": "^10.3.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3"
  }
}
